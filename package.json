{
	"name": "evergreen-navigation",
	"version": "0.1.0",
	"description": "Global back/forward navigation history across Obsidian tabs, stacked tabs and split panes, reusing the tab a note is already open in.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"tests/**/*.test.mts\"",
		"build": "node esbuild.config.mjs production",
		"check": "npm run typecheck && npm run test && npm run build",
		"install:vault": "node scripts/install.mjs",
		"dev:vault": "node scripts/install.mjs --watch"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"navigation",
		"history",
		"stacked-tabs"
	],
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^22.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "^1.14.4",
		"typescript": "~5.6.0"
	}
}
